# Supabase Postgres (Project Settings → Database → Connection string).
# Runtime: the pooled "Transaction" connection on port 6543. pgbouncer=true
# turns off prepared statements, which the pooler can't keep; connection_limit=1
# because every Vercel function instance opens its own pool.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations and the cutover script: the "Session" connection on port 5432.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage + Realtime (Project Settings → API). The service-role key is
# server-only and bypasses every policy — never prefix it with NEXT_PUBLIC_.
# Leave SUPABASE_URL empty in local dev to use ../storage/app and SSE instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The browser joins Realtime with these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for `npm run migrate:from-mysql` at cutover: the Laravel database.
LEGACY_MYSQL_URL="mysql://user:password@127.0.0.1:3306/speedtraqr"

APP_NAME="SPeED TraQR"
APP_URL="http://localhost:3000"

# Must be the SAME value as the Laravel .env APP_KEY (the full "base64:..."
# string). QR stickers already printed are signed with it; a different value
# invalidates every folder currently in the office. See lib/domain/tracking-qr.
APP_KEY=
# Optional dedicated QR key, so rotating APP_KEY alone does not kill printed codes.
QR_SIGNING_KEY=

# At least 32 characters. Signs the session cookie that replaces Laravel's
# server-side session.
SESSION_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SPeED TraQR"

# Shared secret the cron route handlers require (SLA / holds / overdue loans).
# Set it in Vercel too: Vercel Cron sends it as `Authorization: Bearer …`.
CRON_SECRET=

# Speedy's LLM fallback. 127.0.0.1 is unreachable from Vercel: point this at a
# hosted endpoint there, or Speedy answers from the FAQ only.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=90
