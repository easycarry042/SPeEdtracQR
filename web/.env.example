# Same database the Laravel app uses — the rewrite reads the existing schema.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/speedtraqr"

APP_NAME="SPeED TraQR"
APP_URL="http://localhost:3000"

# Must be the SAME value as the Laravel .env APP_KEY (the full "base64:..."
# string). QR stickers already printed are signed with it; a different value
# invalidates every folder currently in the office. See lib/domain/tracking-qr.
APP_KEY=
# Optional dedicated QR key, so rotating APP_KEY alone does not kill printed codes.
QR_SIGNING_KEY=

# At least 32 characters. Signs the session cookie that replaces Laravel's
# server-side session.
SESSION_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SPeED TraQR"

# Shared secret the cron route handlers require (SLA / holds / overdue loans).
CRON_SECRET=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=90
