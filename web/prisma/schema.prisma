generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

/// Supabase Postgres. DATABASE_URL is the pooled (Supavisor, port 6543)
/// connection the app uses at runtime; DIRECT_URL is the session connection
/// (port 5432) that `prisma migrate` needs.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model activity_log {
  id           BigInt    @id @default(autoincrement())
  log_name     String?   @db.VarChar(255)
  description  String    @db.Text
  subject_type String?   @db.VarChar(255)
  subject_id   BigInt?  
  event        String?   @db.VarChar(255)
  causer_type  String?   @db.VarChar(255)
  causer_id    BigInt?  
  properties   Json?
  batch_uuid   String?   @db.Char(36)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)

  @@index([log_name], map: "activity_log_log_name_index")
  @@index([causer_type, causer_id], map: "causer")
  @@index([subject_type, subject_id], map: "subject")
}

model bookings {
  id                  BigInt    @id @default(autoincrement())
  document_id         BigInt   
  resource_id         BigInt   
  quantity            Int?     
  starts_at           DateTime  @db.Timestamp(0)
  ends_at             DateTime  @db.Timestamp(0)
  status              String    @default("pending") @db.VarChar(255)
  released_at         DateTime? @db.Timestamp(0)
  released_by         BigInt?  
  returned_at         DateTime? @db.Timestamp(0)
  returned_by         BigInt?  
  returned_quantity   Int       @default(0)
  damaged_quantity    Int       @default(0)
  lost_quantity       Int       @default(0)
  return_notes        String?   @db.Text
  overdue_reminded_at DateTime? @db.Timestamp(0)
  notes               String?   @db.VarChar(255)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
  document            documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bookings_document_id_foreign")
  releaser            users?    @relation("bookings_released_byTousers", fields: [released_by], references: [id], onUpdate: NoAction, map: "bookings_released_by_foreign")
  resource            resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bookings_resource_id_foreign")
  receiver            users?    @relation("bookings_returned_byTousers", fields: [returned_by], references: [id], onUpdate: NoAction, map: "bookings_returned_by_foreign")

  @@index([document_id], map: "bookings_document_id_index")
  @@index([released_by], map: "bookings_released_by_index")
  @@index([resource_id, starts_at, ends_at], map: "bookings_resource_id_starts_at_ends_at_index")
  @@index([returned_by], map: "bookings_returned_by_index")
}

model departments {
  id                   BigInt                 @id @default(autoincrement())
  name                 String                 @unique(map: "departments_name_unique") @db.VarChar(255)
  code                 String                 @unique(map: "departments_code_unique") @db.VarChar(10)
  internal_step_hours  Int                    @default(72) @db.SmallInt
  is_active            Boolean                @default(true)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  documents            documents[]            @relation("documents_department_idTodepartments")
  requestedDocuments   documents[]            @relation("documents_requesting_department_idTodepartments")
  request_steps        request_steps[]
  request_types        request_types[]
  route_template_steps route_template_steps[]
  users                users[]
}

model document_attachments {
  id          BigInt    @id @default(autoincrement())
  document_id BigInt   
  file_path   String    @db.VarChar(255)
  uploaded_by BigInt?  
  sort_order  Int       @default(0) @db.SmallInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  document    documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_attachments_document_id_foreign")
  uploader    users?    @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "document_attachments_uploaded_by_foreign")

  @@index([document_id], map: "document_attachments_document_id_index")
  @@index([uploaded_by], map: "document_attachments_uploaded_by_index")
}

model document_comments {
  id              BigInt              @id @default(autoincrement())
  document_id     BigInt             
  author_id       BigInt?            
  author_type     String              @default("staff") @db.VarChar(255)
  author_name     String?             @db.VarChar(255)
  body            String              @db.Text
  visibility      String              @default("internal") @db.VarChar(255)
  staff_read_at   DateTime?           @db.Timestamp(0)
  citizen_read_at DateTime?           @db.Timestamp(0)
  attachment_path String?             @db.VarChar(255)
  attachment_name String?             @db.VarChar(255)
  parent_id       BigInt?            
  created_at      DateTime?           @db.Timestamp(0)
  updated_at      DateTime?           @db.Timestamp(0)
  author          users?              @relation(fields: [author_id], references: [id], onUpdate: NoAction, map: "document_comments_author_id_foreign")
  document        documents           @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_comments_document_id_foreign")
  parent          document_comments?  @relation("document_commentsTodocument_comments", fields: [parent_id], references: [id], onUpdate: NoAction, map: "document_comments_parent_id_foreign")
  replies         document_comments[] @relation("document_commentsTodocument_comments")

  @@index([document_id, author_type, staff_read_at], map: "doc_comments_unread_idx")
  @@index([author_id], map: "document_comments_author_id_index")
  @@index([document_id, visibility], map: "document_comments_document_id_visibility_index")
  @@index([parent_id], map: "document_comments_parent_id_index")
}

model document_custody_events {
  id              BigInt    @id @default(autoincrement())
  document_id     BigInt   
  user_id         BigInt   
  capture_method  String    @default("scan") @db.VarChar(255)
  override_reason String?   @db.VarChar(500)
  note            String?   @db.VarChar(500)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  document        documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_custody_events_document_id_foreign")
  user            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_custody_events_user_id_foreign")

  @@index([document_id, created_at], map: "document_custody_events_document_id_created_at_index")
  @@index([user_id], map: "document_custody_events_user_id_index")
}

model document_requirements {
  id                          BigInt                     @id @default(autoincrement())
  document_id                 BigInt                    
  request_type_requirement_id BigInt?                   
  label                       String                     @db.VarChar(255)
  is_mandatory                Boolean                    @default(true)
  review_status               String                     @default("pending") @db.VarChar(255)
  review_comment              String?                    @db.Text
  reviewed_at                 DateTime?                  @db.Timestamp(0)
  reviewed_by                 BigInt?                   
  uploaded_file_path          String?                    @db.VarChar(255)
  verified_at                 DateTime?                  @db.Timestamp(0)
  verified_by                 BigInt?                   
  notes                       String?                    @db.VarChar(255)
  created_at                  DateTime?                  @db.Timestamp(0)
  updated_at                  DateTime?                  @db.Timestamp(0)
  document                    documents                  @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_requirements_document_id_foreign")
  template                    request_type_requirements? @relation(fields: [request_type_requirement_id], references: [id], onUpdate: NoAction, map: "document_requirements_request_type_requirement_id_foreign")
  reviewer                    users?                     @relation("document_requirements_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "document_requirements_reviewed_by_foreign")
  verifier                    users?                     @relation("document_requirements_verified_byTousers", fields: [verified_by], references: [id], onUpdate: NoAction, map: "document_requirements_verified_by_foreign")

  @@index([document_id], map: "document_requirements_document_id_index")
  @@index([request_type_requirement_id], map: "document_requirements_request_type_requirement_id_index")
  @@index([reviewed_by], map: "document_requirements_reviewed_by_index")
  @@index([verified_by], map: "document_requirements_verified_by_index")
}

model documents {
  id                       BigInt                    @id @default(autoincrement())
  tracking_number          String                    @unique(map: "documents_tracking_number_unique") @db.VarChar(255)
  document_type            String                    @db.VarChar(255)
  citizen_name             String?                   @db.VarChar(255)
  citizen_contact          String?                   @db.VarChar(255)
  purpose                  String?                   @db.VarChar(255)
  quantity                 Int?                     
  needed_by                DateTime?                 @db.Date
  description              String?                   @db.Text
  status                   String                    @default("pending") @db.VarChar(255)
  created_by               BigInt?                  
  remarks                  String?                   @db.Text
  completed_at             DateTime?                 @db.Timestamp(0)
  created_at               DateTime?                 @db.Timestamp(0)
  updated_at               DateTime?                 @db.Timestamp(0)
  deleted_at               DateTime?                 @db.Timestamp(0)
  attachment_path          String?                   @db.VarChar(255)
  qr_code_path             String?                   @db.VarChar(255)
  sla_warning_notified_at  DateTime?                 @db.Timestamp(0)
  sla_breach_notified_at   DateTime?                 @db.Timestamp(0)
  assigned_to              BigInt?                  
  assigned_by              BigInt?                  
  department_id            BigInt?                  
  assigned_at              DateTime?                 @db.Timestamp(0)
  accepted_at              DateTime?                 @db.Timestamp(0)
  claimed_at               DateTime?                 @db.Timestamp(0)
  claim_date               DateTime?                 @db.Date
  released_by              BigInt?                  
  status_changed_at        DateTime?                 @db.Timestamp(0)
  source                   String                    @default("walk_in") @db.VarChar(255)
  origin                   String                    @default("external") @db.VarChar(20)
  has_hard_copy            Boolean                   @default(true)
  requesting_department_id BigInt?                  
  amount                   Decimal?                  @db.Decimal(14, 2)
  citizen_email            String?                   @db.VarChar(255)
  notify_citizen           Boolean                   @default(true)
  sla_breached_at          DateTime?                 @db.Timestamp(0)
  status_before_hold       String?                   @db.VarChar(255)
  hold_reason              String?                   @db.Text
  hold_until               DateTime?                 @db.Date
  blocked_by               String?                   @db.VarChar(255)
  held_at                  DateTime?                 @db.Timestamp(0)
  held_by                  BigInt?                  
  decided_by               BigInt?                  
  decided_at               DateTime?                 @db.Timestamp(0)
  hold_reminder_sent_at    DateTime?                 @db.Timestamp(0)
  bookings                 bookings[]
  document_attachments     document_attachments[]
  document_comments        document_comments[]
  document_custody_events  document_custody_events[]
  document_requirements    document_requirements[]
  assigner                 users?                    @relation("documents_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction, map: "documents_assigned_by_foreign")
  assignee                 users?                    @relation("documents_assigned_toTousers", fields: [assigned_to], references: [id], onUpdate: NoAction, map: "documents_assigned_to_foreign")
  creator                  users?                    @relation("documents_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "documents_created_by_foreign")
  decider                  users?                    @relation("documents_decided_byTousers", fields: [decided_by], references: [id], onUpdate: NoAction, map: "documents_decided_by_foreign")
  department               departments?              @relation("documents_department_idTodepartments", fields: [department_id], references: [id], onUpdate: NoAction, map: "documents_department_id_foreign")
  holder                   users?                    @relation("documents_held_byTousers", fields: [held_by], references: [id], onUpdate: NoAction, map: "documents_held_by_foreign")
  releaser                 users?                    @relation("documents_released_byTousers", fields: [released_by], references: [id], onUpdate: NoAction, map: "documents_released_by_foreign")
  requestingDepartment     departments?              @relation("documents_requesting_department_idTodepartments", fields: [requesting_department_id], references: [id], onUpdate: NoAction, map: "documents_requesting_department_id_foreign")
  request_steps            request_steps[]
  staff_highlights         staff_highlights[]

  @@index([assigned_by], map: "documents_assigned_by_index")
  @@index([assigned_to], map: "documents_assigned_to_index")
  @@index([created_by], map: "documents_created_by_index")
  @@index([decided_by], map: "documents_decided_by_index")
  @@index([department_id], map: "documents_department_id_index")
  @@index([held_by], map: "documents_held_by_index")
  @@index([origin], map: "documents_origin_index")
  @@index([released_by], map: "documents_released_by_index")
  @@index([requesting_department_id], map: "documents_requesting_department_id_index")
  @@index([status], map: "documents_status_index")
  @@index([tracking_number], map: "documents_tracking_number_index")
}

model model_has_permissions {
  permission_id BigInt     
  model_type    String      @db.VarChar(255)
  model_id      BigInt     
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_permissions_permission_id_foreign")

  @@id([permission_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_permissions_model_id_model_type_index")
}

model model_has_roles {
  role_id    BigInt
  model_type String @db.VarChar(255)
  model_id   BigInt
  roles      roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "model_has_roles_role_id_foreign")

  @@id([role_id, model_id, model_type])
  @@index([model_id, model_type], map: "model_has_roles_model_id_model_type_index")
}

model notifications {
  id              String    @id @db.Char(36)
  type            String    @db.VarChar(255)
  notifiable_type String    @db.VarChar(255)
  notifiable_id   BigInt   
  data            String    @db.Text
  read_at         DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([notifiable_type, notifiable_id], map: "notifications_notifiable_type_notifiable_id_index")
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model permissions {
  id                    BigInt                  @id @default(autoincrement())
  name                  String                  @db.VarChar(255)
  guard_name            String                  @db.VarChar(255)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  model_has_permissions model_has_permissions[]
  role_has_permissions  role_has_permissions[]

  @@unique([name, guard_name], map: "permissions_name_guard_name_unique")
}

model request_steps {
  id             BigInt      @id @default(autoincrement())
  document_id    BigInt     
  step_order     Int         @db.SmallInt
  department_id  BigInt     
  recipient_id   BigInt?    
  action         String      @db.VarChar(100)
  status         String      @default("pending") @db.VarChar(20)
  acted_by       BigInt?    
  acted_at       DateTime?   @db.Timestamp(0)
  started_at     DateTime?   @db.Timestamp(0)
  remarks        String?     @db.VarChar(500)
  signature_path String?     @db.VarChar(255)
  created_at     DateTime?   @db.Timestamp(0)
  updated_at     DateTime?   @db.Timestamp(0)
  actor          users?      @relation("request_steps_acted_byTousers", fields: [acted_by], references: [id], onUpdate: NoAction, map: "request_steps_acted_by_foreign")
  department     departments @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "request_steps_department_id_foreign")
  document       documents   @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "request_steps_document_id_foreign")
  recipient      users?      @relation("request_steps_recipient_idTousers", fields: [recipient_id], references: [id], onUpdate: NoAction, map: "request_steps_recipient_id_foreign")

  @@index([acted_by], map: "request_steps_acted_by_index")
  @@index([department_id], map: "request_steps_department_id_index")
  @@index([document_id, step_order], map: "request_steps_document_id_step_order_index")
  @@index([recipient_id], map: "request_steps_recipient_id_index")
}

model request_type_requirements {
  id                    BigInt                  @id @default(autoincrement())
  request_type_id       BigInt                 
  label                 String                  @db.VarChar(255)
  is_mandatory          Boolean                 @default(true)
  sort_order            Int                     @default(0)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  document_requirements document_requirements[]
  requestType           request_types           @relation(fields: [request_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "request_type_requirements_request_type_id_foreign")

  @@index([request_type_id], map: "request_type_requirements_request_type_id_index")
}

model request_types {
  id                        BigInt                      @id @default(autoincrement())
  name                      String                      @unique(map: "request_types_name_unique") @db.VarChar(255)
  kind                      String                      @default("document") @db.VarChar(255)
  department_id             BigInt?                    
  resource_id               BigInt?                    
  description               String?                     @db.Text
  is_active                 Boolean                     @default(true)
  sort_order                Int                         @default(0)
  created_at                DateTime?                   @db.Timestamp(0)
  updated_at                DateTime?                   @db.Timestamp(0)
  request_type_requirements request_type_requirements[]
  department                departments?                @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "request_types_department_id_foreign")
  resource                  resources?                  @relation(fields: [resource_id], references: [id], onUpdate: NoAction, map: "request_types_resource_id_foreign")

  @@index([department_id], map: "request_types_department_id_index")
  @@index([resource_id], map: "request_types_resource_id_index")
}

model resources {
  id               BigInt          @id @default(autoincrement())
  name             String          @unique(map: "resources_name_unique") @db.VarChar(255)
  kind             String          @default("facility") @db.VarChar(255)
  total_quantity   Int?           
  damaged_quantity Int             @default(0)
  capacity         Int?           
  location         String?         @db.VarChar(255)
  description      String?         @db.Text
  is_active        Boolean         @default(true)
  sort_order       Int             @default(0)
  created_at       DateTime?       @db.Timestamp(0)
  updated_at       DateTime?       @db.Timestamp(0)
  bookings         bookings[]
  request_types    request_types[]
}

model role_has_permissions {
  permission_id BigInt     
  role_id       BigInt     
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_permission_id_foreign")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_has_permissions_role_id_foreign")

  @@id([permission_id, role_id])
  @@index([role_id], map: "role_has_permissions_role_id_index")
}

model roles {
  id                   BigInt                 @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  guard_name           String                 @db.VarChar(255)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  model_has_roles      model_has_roles[]
  role_has_permissions role_has_permissions[]

  @@unique([name, guard_name], map: "roles_name_guard_name_unique")
}

model route_template_steps {
  id                BigInt          @id @default(autoincrement())
  route_template_id BigInt         
  step_order        Int             @db.SmallInt
  department_id     BigInt         
  action            String          @db.VarChar(100)
  condition         String?         @db.VarChar(30)
  created_at        DateTime?       @db.Timestamp(0)
  updated_at        DateTime?       @db.Timestamp(0)
  department        departments     @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "route_template_steps_department_id_foreign")
  template          route_templates @relation(fields: [route_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "route_template_steps_route_template_id_foreign")

  @@index([department_id], map: "route_template_steps_department_id_index")
  @@index([route_template_id, step_order], map: "route_template_steps_route_template_id_step_order_index")
}

model route_templates {
  id          BigInt                 @id @default(autoincrement())
  name        String                 @unique(map: "route_templates_name_unique") @db.VarChar(255)
  description String?                @db.VarChar(500)
  is_active   Boolean                @default(true)
  created_at  DateTime?              @db.Timestamp(0)
  updated_at  DateTime?              @db.Timestamp(0)
  steps       route_template_steps[]
}

model staff_highlights {
  id             BigInt     @id @default(autoincrement())
  user_id        BigInt    
  document_id    BigInt?   
  highlight_type String     @default("note") @db.VarChar(255)
  body           String     @db.Text
  created_at     DateTime?  @db.Timestamp(0)
  updated_at     DateTime?  @db.Timestamp(0)
  document       documents? @relation(fields: [document_id], references: [id], onUpdate: NoAction, map: "staff_highlights_document_id_foreign")
  user           users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "staff_highlights_user_id_foreign")

  @@index([document_id], map: "staff_highlights_document_id_index")
  @@index([user_id, created_at], map: "staff_highlights_user_id_created_at_index")
}

model users {
  id                      BigInt                    @id @default(autoincrement())
  name                    String                    @db.VarChar(255)
  email                   String                    @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at       DateTime?                 @db.Timestamp(0)
  is_active               Boolean                   @default(true)
  last_active_at          DateTime?                 @db.Timestamp(0)
  avatar_path             String?                   @db.VarChar(255)
  department_id           BigInt?                  
  signature_path          String?                   @db.VarChar(255)
  password                String                    @db.VarChar(255)
  remember_token          String?                   @db.VarChar(100)
  identity_code           String?                   @unique(map: "users_identity_code_unique") @db.VarChar(40)
  created_at              DateTime?                 @db.Timestamp(0)
  updated_at              DateTime?                 @db.Timestamp(0)
  deleted_at              DateTime?                 @db.Timestamp(0)
  releasedBookings        bookings[]                @relation("bookings_released_byTousers")
  returnedBookings        bookings[]                @relation("bookings_returned_byTousers")
  document_attachments    document_attachments[]
  document_comments       document_comments[]
  document_custody_events document_custody_events[]
  reviewedRequirements    document_requirements[]   @relation("document_requirements_reviewed_byTousers")
  verifiedRequirements    document_requirements[]   @relation("document_requirements_verified_byTousers")
  assignedByDocuments     documents[]               @relation("documents_assigned_byTousers")
  assignedDocuments       documents[]               @relation("documents_assigned_toTousers")
  createdDocuments        documents[]               @relation("documents_created_byTousers")
  decidedDocuments        documents[]               @relation("documents_decided_byTousers")
  heldDocuments           documents[]               @relation("documents_held_byTousers")
  releasedDocuments       documents[]               @relation("documents_released_byTousers")
  actedSteps              request_steps[]           @relation("request_steps_acted_byTousers")
  receivedSteps           request_steps[]           @relation("request_steps_recipient_idTousers")
  staff_highlights        staff_highlights[]
  department              departments?              @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "users_department_id_foreign")

  @@index([department_id], map: "users_department_id_index")
}
